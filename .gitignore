# Python bytecode and caches
__pycache__/
*.pyc
*.pyo
*.pyd

# macOS filesystem metadata
.DS_Store

# Test and analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Editor and OS temp artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# Local temp scratch
*.tmp
*.temp
tmp/
temp/

# Runtime execution artifacts — pipeline run manifests, stage manifests, and log outputs.
# These are operational evidence produced at runtime, not architectural source.
# The scaffolding directories and their .gitkeep placeholders are tracked;
# all content produced during a run is gitignored.
runs/**
!runs/
!runs/.gitkeep
!runs/README.md
!runs/logs/
runs/logs/**
!runs/logs/.gitkeep
!runs/manifests/
runs/manifests/**
!runs/manifests/.gitkeep
!runs/manifests/example_run_manifest.json
!runs/stage_manifests/
runs/stage_manifests/**
!runs/stage_manifests/.gitkeep

# Runtime current-state outputs.
# Generated deterministically during each replay matrix build execution.
# Includes: analytical_universe.csv, replay_matrix.csv, replay_availability.csv,
# replay_inputs.csv, replay_performance_series.csv, current_snapshot_metadata.json.
# These are rebuildable at any time via build_wp05b_replay_matrix.py.
# Never source-controlled — consumers read from this path at runtime only.
data/current/

# Immutable historical replay and analytical universe artifacts.
# Includes: replay partitions (snapshot_date=.../replay_id=.../),
# analytical universe snapshots, snapshot registries (analytical_snapshot_registry.csv,
# replay_snapshot_registry.csv), market data partitions, and signal history.
# Historical analytical truth is retained locally only — never pushed to source control.
# The data/history/ root and benchmark contract scaffolding are tracked as anchors;
# all content produced at runtime is gitignored.
data/history/**
!data/history/
!data/history/.gitkeep
!data/history/benchmarks/
!data/history/benchmarks/benchmark_outcomes.csv
!data/history/benchmarks/benchmark_registry_history.csv
!data/history/benchmarks/benchmark_snapshots.csv

# Raw provider payload intake.
# ESS signal files ingested from external data providers are operational inputs,
# not architectural source. Lane placeholder directories are tracked; all
# provider payload files are gitignored.
incoming/ess/**
!incoming/ess/
!incoming/ess/non_starmine_zacks/
!incoming/ess/non_starmine_zacks/.gitkeep
!incoming/ess/starmine/
!incoming/ess/starmine/.gitkeep

# Fetched signal data from external providers (Zacks, Yahoo, Danelfin).
# These are runtime artifacts refreshed on demand — not source-controlled.
# The data/signals/ directory tree is rebuildable by running the fetch_* scripts.
data/signals/**
!data/signals/

# Supplemental seed data IS tracked (watchlist, portfolio vehicles).
# Only runtime signal fetches are excluded above.

# One-off debug and investigation residue.
# These are scratch files created during interactive debugging sessions.
# They are not governed build artifacts — governed diagnostics belong under
# explicitly named build_* scripts in scripts/diagnostics/.
final_verify.py
verify_state.py
process_report.py
status_output.txt
# Pattern covers any debug_*.py scripts created during future investigation sessions.
scripts/diagnostics/debug_*.py
# Root-level throwaway migration / scratch scripts.
migrate_zacks.py
script.py

# Preserve deterministic test fixtures
!tests/fixtures/
!tests/fixtures/**
