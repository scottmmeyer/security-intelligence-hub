# Python bytecode and caches
__pycache__/
*.pyc
*.pyo
*.pyd

# macOS filesystem metadata
.DS_Store

# Test and analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Editor and OS temp artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# Local temp scratch
*.tmp
*.temp
tmp/
temp/

# Operational/runtime isolation (post-milestone)
# Keep curated run scaffolding and example manifest tracked.
runs/**
!runs/
!runs/.gitkeep
!runs/README.md
!runs/logs/
runs/logs/**
!runs/logs/.gitkeep
!runs/manifests/
runs/manifests/**
!runs/manifests/.gitkeep
!runs/manifests/example_run_manifest.json
!runs/stage_manifests/
runs/stage_manifests/**
!runs/stage_manifests/.gitkeep

# Current mutable operational outputs
data/current/

# History runtime partitions and indexes are operational state.
# Keep benchmark contract scaffolding tracked.
data/history/**
!data/history/
!data/history/.gitkeep
!data/history/benchmarks/
!data/history/benchmarks/benchmark_outcomes.csv
!data/history/benchmarks/benchmark_registry_history.csv
!data/history/benchmarks/benchmark_snapshots.csv

# Raw provider payload intake is operational, not source-controlled.
# Keep deterministic lane placeholders tracked.
incoming/ess/**
!incoming/ess/
!incoming/ess/non_starmine_zacks/
!incoming/ess/non_starmine_zacks/.gitkeep
!incoming/ess/starmine/
!incoming/ess/starmine/.gitkeep

# Debug/temp helper residue
final_verify.py
verify_state.py
process_report.py
status_output.txt

# Preserve deterministic test fixtures
!tests/fixtures/
!tests/fixtures/**
